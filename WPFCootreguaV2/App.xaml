<Application x:Class="WPFCootreguaV2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPFCootreguaV2"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries >
                <!-- Agrega el diccionario de las constantes -->
                <ResourceDictionary Source="Presentation/Shared/ResourceDictionaries/Constants/Fonts.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Presentation/Shared/ResourceDictionaries/Constants/Images.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Presentation/Shared/ResourceDictionaries/Constants/SVG.xaml"></ResourceDictionary>

                <!-- Agrega el diccionario de los estilos -->
                <ResourceDictionary Source="Presentation/Shared/ResourceDictionaries/Styles/FontStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Presentation/Shared/ResourceDictionaries/Styles/ButtonStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Presentation/Shared/ResourceDictionaries/Styles/IconStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Presentation/Shared/ResourceDictionaries/Styles/MiscellaneousStyles.xaml"></ResourceDictionary>

                <!-- Agrega el diccionario de material design-->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

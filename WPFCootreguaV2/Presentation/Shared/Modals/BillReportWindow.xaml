<Window x:Class="WPFCootreguaV2.Modals.BillReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFCootreguaV2.Modals"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:converters="clr-namespace:WPFCootreguaV2.Presentation.Shared.Converters"
        mc:Ignorable="d"
        Title="ModalWindow"
        WindowStyle="None"
        Topmost="False"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Height="1920" Width="1080">

    <Viewbox x:Name="WindowVB" Stretch="Uniform">
        <Grid Width="1080" Height="1920">
            <Grid.Background>
                <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
            </Grid.Background>
            <ListBox x:Name="DataView" Background="#0f0f"  BorderThickness="0" Grid.Row="1" Grid.ColumnSpan="5"  HorizontalAlignment="Center" VerticalAlignment="Center"  >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="1080">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Columna de Fecha pago -->
                            <TextBlock  Text="{Binding Key}" Style="{StaticResource ViewBoxTextStyle}" HorizontalAlignment="Left" FontWeight="Bold" Grid.Column="0" FontSize="30"/>
                            <!-- Columna de Total -->
                            <TextBlock  Text="{Binding Value}" Style="{StaticResource ViewBoxTextStyle}" HorizontalAlignment="Left" Grid.Column="1" FontSize="30"/>
                            <!-- Columna de Selecione -->


                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock 
                x:Name="TxtTitle" 
                Style="{StaticResource TitleStyle}"
                Margin="0,350,0,0"
            />

            <TextBlock
                x:Name="TxtMsg" 
                Text="{Binding Message}"
                Style="{StaticResource MessageTextStyle}"
                TextWrapping="WrapWithOverflow"
                TextAlignment="Center" Height="520" Margin="190,548,190,0" 
                />

        </Grid>
    </Viewbox>
</Window>

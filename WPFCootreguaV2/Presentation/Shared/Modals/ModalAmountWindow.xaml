<Window x:Class="WPFCootreguaV2.Modals.ModalAmountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFCootreguaV2.Modals"
        mc:Ignorable="d"
        Title="ModalAmountWindow" 
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Height="550" Width="800">
    <!--<Window.Background>
        <ImageBrush ImageSource="{StaticResource MODALGENERIC}" />
    </Window.Background>-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="230" />
            <RowDefinition Height="313.328" />
            <RowDefinition Height="6.672"/>
        </Grid.RowDefinitions>
        <Grid Grid.ColumnSpan="2"  >
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                Text="Información"
                FontSize="80"
                FontWeight="SemiBold"                   
            />
        </Grid>
        <Grid Grid.Column="1">
            <Image 
                x:Name="BtnCancel"
                Source="/Images/Others/x.png"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" 
                Margin="0,30,45,70"
                Height="90"  
                Stretch="Uniform"
                MouseDown="BtnCancel_TouchDown"
            />
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <TextBlock
                Name="txtMsInformacion"
                Text="Ingrese el valor que desea pagar"
                FontSize="40"
                Foreground="#606060"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
            />
            <TextBox 
                x:Name="TxtVal"
                Text="{Binding Val, StringFormat={}{0:C0}, UpdateSourceTrigger=PropertyChanged}"
                Width="400"
                Height="60"
                TextAlignment="Center"
                Margin="0,0,0,140" 
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="37"
                FontFamily="Arial" 
                IsHitTestVisible="True"
                CaretBrush="#FFB2B0B8"
                TouchDown="TxtVal_TouchDown"
                TextChanged="TxtVal_TextChanged"
                PreviewTextInput="TextBox_PreviewTextInput"
                d:Text="3238101149" 
                Style="{StaticResource KeyboardTextBoxStyle}" 
                Foreground="{StaticResource SECONDARYCOLOR}"
            />


            <TextBlock 
                x:Name="TxtError"
                FontSize="25"
                Foreground="red"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0,0,0"
            />

        </Grid>
        <Grid Grid.ColumnSpan="2" Margin="0,212,0,11" Grid.RowSpan="2">
            <Grid x:Name="BtnPagar" Tag="1" Height="70" Width="300" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,179,0,0" MouseDown="OptionPagar" Cursor="Hand">
                <Border Background="#96d12c" CornerRadius="25">
                    <Grid>
                        <!-- Sección izquierda con ícono -->
                        <Border Width="40" Height="70" Background="#373737" CornerRadius="10,0,0,10" HorizontalAlignment="Left">
                            <Polyline Points="8,1 20,16 8,31"
                                  Stroke="White"
                                  StrokeThickness="8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>

                        </Border>
                        <TextBlock x:Name="BtnPagarTexto"
                       Text="Pagar" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       FontSize="36" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

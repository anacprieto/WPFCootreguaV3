<Window x:Class="WPFCootreguaV2.Modals.ModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFCootreguaV2.Modals"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:converters="clr-namespace:WPFCootreguaV2.Presentation.Shared.Converters"
        mc:Ignorable="d"
        Title="ModalWindow"
        WindowStyle="None"
        Topmost="False"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Height="1920" Width="1080">

    <Window.Resources>
        <!-- Estilo para botones redondeados -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                Padding="20,15">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox x:Name="WindowVB" Stretch="Uniform">
        <Grid Width="1080" Height="1920">
            <Grid.RowDefinitions>
                <RowDefinition Height="360" />
                <RowDefinition Height="810" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <TextBlock 
                x:Name="TxtTitle" 
                Style="{StaticResource TitleStyle}"
                Margin="0,350,0,0"
            />

                <TextBlock
                x:Name="TxtMsg" 
                Text="{Binding Message}"
                Style="{StaticResource MessageTextStyle}"
                TextWrapping="WrapWithOverflow"
                TextAlignment="Center" 
                Height="520" 
                Margin="190,548,190,0"
            />
            </Grid>

            <Grid Grid.Row ="2">
                <!--
            <Button x:Name="BtnNo" 
                    Content="No" 
                    Style="{StaticResource RoundedButtonStyle}"
                    Background="#FFE53935"
                    Margin="10,1726,624,50"
                    MouseDown="BtnNo_MouseDown" />

            <Button x:Name="BtnOk" 
                    Content="Continuar" 
                    Style="{StaticResource RoundedButtonStyle}"
                    Margin="410,1502,224,274"
                    MouseDown="BtnOk_MouseDown" />

            <Button x:Name="BtnYes" 
                    Content="Sí" 
                    Style="{StaticResource RoundedButtonStyle}"
                    Background="#FF4CAF50"
                    Margin="633,1726,0,120"
                    MouseDown="BtnYes_MouseDown"/> -->
                <Image 
                  x:Name="BtnOk" 
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  Height="145"
                  Margin="307,495,0,0"
                  Source="/Images/Buttons/aceptar.png" 
                  Stretch="Uniform" 
                  MouseDown="BtnOk_MouseDown" Width="471"/>

                <Image 
                  x:Name="BtnNo" 
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  Height="100"
                  Margin="75,390,0,0"
                  Source="/Images/Buttons/cancelar.png"
                  Stretch="Uniform" 
                  MouseDown="BtnNo_MouseDown"/>

                <Image 
                  x:Name="BtnYes" 
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  Height="100"
                  Margin="0,390,48,0"
                  Source="/Images/Buttons/aceptar.png" 
                  Stretch="Uniform" 
                  MouseDown="BtnYes_MouseDown"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
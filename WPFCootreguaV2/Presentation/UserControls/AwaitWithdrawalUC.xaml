<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.AwaitWithdrawalUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             xmlns:gif="http://wpfanimatedgif.codeplex.com"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d" 
             d:DesignHeight="1920" d:DesignWidth="1080">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </Grid.Background>



       

        <Image 
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="250"
            Source="/Image/Other/logo2.png" Margin="0,196,0,0"/>


        <TextBlock
            Text="Transacción en proceso"
            TextWrapping="Wrap"
            TextAlignment="Center" 
            FontSize="80"
            Foreground="{StaticResource SECONDARYCOLOR}"
            FontFamily="{StaticResource FONTFAMILY1}"
            FontWeight="Light"
            Visibility="Visible" 
            Margin="0,560,0,0" 
            HorizontalAlignment="Center" 
            Width="500" VerticalAlignment="Top" 
        />

        <TextBlock
            Text="Por favor espere un momento"
            TextWrapping="Wrap"
            TextAlignment="Center" 
            FontSize="60"
            Foreground="Black"
            FontFamily="Museo Sans 300"
            FontWeight="Light"
            Visibility="Visible" 
            Margin="0,1320,0,0" 
            HorizontalAlignment="Center" 
            Width="800" VerticalAlignment="Top" 
        />


        <mah:ProgressRing 
            x:Name="LoadGif"
            Foreground="{StaticResource SECONDARYCOLOR}"
            IsActive="True" 
            Height="400" 
            Width="400"
            Visibility="Visible" Margin="0,832,0,0" VerticalAlignment="Top"
        />


        <Image 
    Source="/Image/Other/Superintendencia.png" Margin="0,1405,906,54"/>
        <Image 
    Source="/Image/Other/logoecity.png" Margin="139,1773,718,50"/>


    </Grid>
</local:AppUserControl>

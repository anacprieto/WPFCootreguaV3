<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.CancelPayUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             Height="1920" 
             Width="1080"
             Panel.ZIndex="1">

    <Grid Width="680" Height="1720" HorizontalAlignment="Right" Margin="0,163,0,37">
        <Grid.RowDefinitions>
            <RowDefinition Height="450" />
            <RowDefinition Height="600" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock x:Name="TxtTimer" d:Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,22,0,0"/>

            <TextBlock 
            Text="Transacción Cancelada" 
            FontFamily="pack://application:,,,/fonts/#Ubuntu"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            TextAlignment="Center"
            FontWeight="Bold" 
            FontSize="90" 
        />
        </Grid>
        <Grid Grid.Row="1">
            <Label 
            x:Name="lblTitle"
            Content="Valor a Retirar" 
            FontFamily="pack://application:,,,/fonts/#Ubuntu"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontWeight="Bold" 
            FontSize="80" 
        />
            <TextBlock 
            x:Name="txtValueReturn"
            Text="$ 0"
            FontFamily="pack://application:,,,/fonts/#Ubuntu"
            Foreground="Gray"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontWeight="Bold" 
            FontSize="80"
            Margin="0,0,0,0"
        />
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock 
            Text="Por favor espere, estamos contando su dinero" 
            FontFamily="pack://application:,,,/fonts/#Ubuntu"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontWeight="Bold" 
            FontSize="70" 
            TextWrapping="Wrap"
            TextAlignment="Center"
        />
        </Grid>
    </Grid>
</local:AppUserControl>
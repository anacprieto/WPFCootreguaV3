<local:AppUserControl
             x:Class="WPFCootreguaV2.UserControls.ConfigUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d" 
             d:DesignHeight="1920" d:DesignWidth="1080">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </Grid.Background>

        <TextBlock
             FontSize="75"
             VerticalAlignment="Top"
             HorizontalAlignment="Right"
             Margin="0,367,20,0"
             TextAlignment="Right"
             TextWrapping="Wrap"
             Width="800"
             FontFamily="Arial" 
             Text="Configuración del dispositivo"
             FontWeight="Bold" />

        <TextBlock 
             Text="Espere mientras se configura el dispositivo para iniciar"
             FontFamily="Arial"
             FontSize="60"
             VerticalAlignment="Top"
             HorizontalAlignment="Right"
             Margin="0,581,20,0"
             Width="700"
             TextWrapping="Wrap"
             TextAlignment="Right"
             FontWeight="Bold" />
        <local:GifViewer PathFolder="Images/Gif/GifLoading" Margin="442,886,49,375" RenderTransformOrigin="0.5,0.5" >
            <local:GifViewer.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </local:GifViewer.RenderTransform>
        </local:GifViewer>
    </Grid>
</local:AppUserControl>

<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.FinishUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="1920" d:DesignWidth="1080">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKCALIFICA}" Stretch="Uniform"/>
        </Grid.Background>

        <!-- HEADER -->
        <TextBlock x:Name="TxtTimer" Text="" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}"/>

        <!-- BODY -->

        <Grid Margin="0,-16,0,16">

            <Grid x:Name="StartContainer" Height="135" VerticalAlignment="Top" Margin="259,760,259,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Tag="1" Source="{StaticResource ICO_STAR}" Cursor="Hand" MouseDown="BtnRating" Margin="12,0,0,50"/>
                <Image Grid.Column="1" Tag="2" Source="{StaticResource ICO_STAR}" Cursor="Hand" MouseDown="BtnRating" Margin="12,0,5,50"/>
                <Image Grid.Column="2" Tag="3" Source="{StaticResource ICO_STAR}" Cursor="Hand" MouseDown="BtnRating" Margin="0,0,2,50"/>
                <Image Grid.Column="3" Tag="4" Source="{StaticResource ICO_STAR}" Cursor="Hand" MouseDown="BtnRating" Margin="5,3,11,50"/>
                <Image Grid.Column="4" Tag="5" Source="{StaticResource ICO_STAR}" Cursor="Hand" MouseDown="BtnRating" Margin="0,0,13,50"/>

            </Grid>

        </Grid>


        <Image x:Name="BtnContinuar" Source="{StaticResource BTN_FINALIZAR}" Margin="386,1495,399,302"
            MouseDown="FinishBtn" Visibility="Visible"/>

        <!--FOOTER-->

        <Image Source="{StaticResource ATENTION_LINE}" Margin="0,1733,0,42" Width="466" HorizontalAlignment="Center"
            />

    </Grid>
</local:AppUserControl>

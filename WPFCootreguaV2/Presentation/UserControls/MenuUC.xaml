<local:AppUserControl x:Class="WPFCootreguaV2.Presentation.UserControls.MenuUC"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="1920" d:DesignWidth="1080">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </Grid.Background>

        <TextBlock x:Name="TxtTimer" d:Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,22,0,0"/>

        <!-- HEADER -->
        <Image x:Name="BtnAtras" Source="{StaticResource BTN_ATRAS}" Margin="48,48,858,1808"
        MouseDown="BtnAtras_MouseDown"/>

        <Image x:Name="BtnSalir" Source="{StaticResource BTN_SALIR}" Margin="861,40,33,1796"
        MouseDown="BtnSalir_MouseDown"/>


        <!--BODY-->
        <Image Source="{StaticResource TXTPAGAAQUI}" Margin="321,279,321,1515" />



        <Image x:Name="BtnPredial" Source="{StaticResource BTN_PREDIAL}" Margin="109,789,599,691"
        MouseDown="BtnPay_Predial"/>


        <Image  x:Name="BtnICA" Source="{StaticResource BTN_ICA}" Margin="637,789,117,691"
        MouseDown="BtnPay_ICA"/>

        <!--FOOTER-->

        <Image Source="{StaticResource ATENTION_LINE}" Margin="292,1740,292,50" />

    </Grid>
</local:AppUserControl>

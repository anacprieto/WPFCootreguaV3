<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.IdentificationUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             Height="1920" 
             Width="1080"
             Panel.ZIndex="1">

    <local:AppUserControl.Background>
        <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
    </local:AppUserControl.Background>
    
    <Grid Width="680" Height="1720" HorizontalAlignment="Right">
        <Grid.RowDefinitions>
            <RowDefinition Height="500" />
            <RowDefinition Height="*" />
            <RowDefinition Height="400" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock x:Name="TxtTimer" d:Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,22,0,0"/>
            <TextBox x:Name="TxtCelular"
        Background="{x:Null}"
               FontSize="40" 
               TextAlignment="Center"
               PreviewTextInput="TextBox_PreviewTextInput"
               d:Text="3238101149" 
               Style="{StaticResource KeyboardTextBoxStyle}" 
               Foreground="{StaticResource SECONDARYCOLOR}"
               Margin="19,123,0,0" 
               HorizontalAlignment="Left" 
               Height="74"
               Width="651" 
                     BorderBrush="Aqua"
               VerticalAlignment="Top"/>
            <TextBox
            x:Name="TxtIdentification"
            md:HintAssist.Hint="      Ingrese su Cédula"
            md:HintAssist.IsFloating="True"
            md:HintAssist.FloatingScale="0.3"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsEnabled="False"
            Tag="Identification"
            Margin="0,0,0,150" 
            Width="550"
            TextAlignment="Center"
            FontSize="50"
            TextChanged="TxtIdentification_TextChanged" BorderBrush="{x:Null}"
        />
        </Grid>

        <Grid Grid.Row="1">

            <TextBlock  x:Name="TxtStatusMsg" Text="{Binding StatusMsg}" Style="{StaticResource StatusTextStyle}" Margin="0,82,0,0"/>

            <local:NumericKeyboard x:Name="Keyboard" Margin="10,257,10,10" />
        </Grid>

        <Grid Grid.Row="2">

            <Image x:Name="BtnCancelar" Source="/Images/Buttons/BtnAtrasTxt.png" 
               Height="90"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Margin="42,183,0,0"
             Stretch="Uniform"
             TouchDown="Btn_Cancelar_Touch" RenderTransformOrigin="0.502,-0.244"/>

            <Image x:Name="BtnContinuar" Source="{StaticResource BTN_CONTINUAR}" Height="90"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,183,52,0"
              Stretch="Uniform"
              MouseDown="BtnConsultar_Touch"/>

        </Grid>

    </Grid>

</local:AppUserControl>

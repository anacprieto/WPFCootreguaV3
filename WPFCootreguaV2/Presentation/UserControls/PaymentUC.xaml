<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.PaymentUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="1920" d:DesignWidth="1080"
             >
    <Grid x:Name="MainGrid">
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </Grid.Background>

        <!-- BODY -->
        <Border  Height="1100" BorderThickness="10" BorderBrush="#326ea5" CornerRadius="50" Padding="40" Width="1000">
            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="2*" />

                </Grid.RowDefinitions>
                <TextBlock  Text="INGRESE EL DINERO"  Style="{StaticResource TitleStyle}" Width="900" Grid.Row="0"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Margin="30, 15" Grid.Column="0" Grid.Row="0" Background="{StaticResource PRIMARYCOLOR}" CornerRadius="15" Height="70">
                        <TextBlock Text="Denominación" Style="{StaticResource CommonTextStyle}" Foreground="{StaticResource LIGTHCOLOR}" VerticalAlignment="Center" FontSize="30"/>
                    </Border>
                    <Border Margin="30, 15" Grid.Column="1" Grid.Row="0" Background="{StaticResource PRIMARYCOLOR}" CornerRadius="15" Height="70">
                        <TextBlock Text="Cantidad" Style="{StaticResource CommonTextStyle}" Foreground="{StaticResource LIGTHCOLOR}" VerticalAlignment="Center" FontSize="30"/>
                    </Border>
                    <Border Margin="30, 15" Grid.Column="2" Grid.Row="0" Background="{StaticResource PRIMARYCOLOR}" CornerRadius="15" Height="70">
                        <TextBlock Text="Total ($)" Style="{StaticResource CommonTextStyle}" Foreground="{StaticResource LIGTHCOLOR}" VerticalAlignment="Center" FontSize="30"/>
                    </Border>

                    <!--LISTBOX-->
                    <ListBox x:Name="DataView" Background="Transparent" BorderThickness="0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="810"  >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Columna Denominación -->
                                    <TextBlock  Text="{Binding DenominationValue, StringFormat={}{0:C0}}" Style="{StaticResource ViewBoxTextStyle}" Margin="5" Grid.Column="0" HorizontalAlignment="Left"/>
                                    <!-- Columna de Cantidad -->
                                    <TextBlock  Text="{Binding Quantity}" Style="{StaticResource ViewBoxTextStyle}" Margin="5" Grid.Column="1" HorizontalAlignment="center"/>
                                    <!-- Columna de Total -->
                                    <TextBlock  Text="{Binding TotalDenomAmount, StringFormat=\{0:C0\}}" Style="{StaticResource ViewBoxTextStyle}" FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Valor ingresado:" Style="{StaticResource ViewBoxTextStyle}" Grid.Row="0" />
                        <TextBlock Text="Valor faltante:" Style="{StaticResource ViewBoxTextStyle}" Grid.Row="1" />
                        <TextBlock Text="Valor sobrante:" Style="{StaticResource ViewBoxTextStyle}" Grid.Row="2" />
                        <TextBlock Text="Valor total:" Style="{StaticResource ViewBoxTextStyle}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource PRIMARYCOLOR}" Grid.Row="3" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding EnteredAmount, StringFormat=\{0:C0\}}" Style="{StaticResource ViewBoxTextStyle}" HorizontalAlignment="Right" Grid.Row="0" />
                        <TextBlock Text="{Binding RemainingAmount, StringFormat=\{0:C0\}}" Style="{StaticResource ViewBoxTextStyle}" HorizontalAlignment="Right" Grid.Row="1" />
                        <TextBlock Text="{Binding ReturnAmount, StringFormat=\{0:C0\}}" Style="{StaticResource ViewBoxTextStyle}" HorizontalAlignment="Right" Grid.Row="2" />
                        <TextBlock Text="{Binding PayAmount, StringFormat=\{0:C0\}}" Style="{StaticResource ViewBoxTextStyle}" HorizontalAlignment="Right" FontSize="40" FontWeight="Bold" Foreground="{StaticResource TITLECOLOR}" Grid.Row="3" />

                    </Grid>
                </Grid>
            </Grid>

        </Border>

        <Image x:Name="BtnCancel" Source="{StaticResource BTN_CANCELAR}" Margin="392,1552,392,283"
            MouseDown="BtnCancel_TouchDown"/>

        <!--FOOTER-->

        <Image Source="{StaticResource ATENTION_LINE}" Margin="353,1758,353,44" />


    </Grid>
</local:AppUserControl>

<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.AuthenticationRetirosUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             Height="1920" 
             Width="1080"
             Panel.ZIndex="1">

        <local:AppUserControl.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </local:AppUserControl.Background>

        <Grid x:Name="MainGrid" Width="680" Height="1720" HorizontalAlignment="Right">
        <Grid.RowDefinitions>
            <RowDefinition Height="500" />
            <RowDefinition Height="*" />
            <RowDefinition Height="400" />
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,644" Grid.RowSpan="2">
            <TextBlock x:Name="TxtTimer" d:Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,22,0,0"/>
        </Grid>

        <Grid Grid.Row="1" >
            <local:GifViewer PathFolder="Images/Gif/GifHuella" Margin="87,226,87,188" RenderTransformOrigin="-1.019,-0.023" >
                <local:GifViewer.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform AngleX="-0.277"/>
                        <RotateTransform/>
                        <TranslateTransform Y="546.012" X="-2.993"/>
                    </TransformGroup>
                </local:GifViewer.RenderTransform>
            </local:GifViewer>
            <TextBlock x:Name="TxtStatusMsg"
               Text="{Binding StatusMsg}"
               Style="{StaticResource StatusTextStyle}" 
               Margin="0,58,0,0"/>
        </Grid>

        <Grid Grid.Row="2" >
            <Image x:Name="BtnCancelar" Source="{StaticResource BTN_CANCELAR}" 
             Height="150"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,94,0,0"
             Stretch="Uniform"
             PreviewMouseDown="OpcionButton_Click" RenderTransformOrigin="-2.235,1.238" Width="340"/>
            
        </Grid>

    </Grid>
</local:AppUserControl>

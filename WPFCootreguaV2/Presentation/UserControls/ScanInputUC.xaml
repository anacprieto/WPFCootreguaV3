<local:AppUserControl x:Class="WPFCootreguaV2.Presentation.UserControls.ScanInputUC"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
      xmlns:gif="http://wpfanimatedgif.codeplex.com"
      mc:Ignorable="d" 
      d:DesignHeight="1920" d:DesignWidth="1080"
      >

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </Grid.Background>

        <Image x:Name="BtnAtras" Source="{StaticResource BTN_ATRAS}" Margin="37,37,828,1755"
  MouseDown="BtnAtras_MouseDown"/>

        <Image x:Name="BtnSalir" Source="{StaticResource BTN_SALIR}" Margin="840,39,26,1755"
  MouseDown="BtnSalir_MouseDown"/>

        <TextBlock x:Name="TxtTimer" Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,27,0,0"/>

        <TextBlock 
       x:Name="TxtStatusMsg" Text="{Binding StatusMsg}" Style="{StaticResource StatusTextStyle}" Width="480" Height="100"
       Margin="0,636,0,0" />

        <local:GifViewer PathFolder="Images/Gif/GifFactureFrames" Margin="168,346,183,300" />

    </Grid>
</local:AppUserControl>

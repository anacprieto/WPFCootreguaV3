<local:AppUserControl x:Class="WPFCootreguaV2.Presentation.UserControls.SelectOptionUC"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
  xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
  xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" 
  xmlns:gif="http://wpfanimatedgif.codeplex.com"
  mc:Ignorable="d" 
  d:DesignHeight="1920" d:DesignWidth="1080">

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </Grid.Background>

        <!-- HEADER -->
        <Image x:Name="BtnAtras" Source="{StaticResource BTN_ATRAS}" Margin="47,38,867,1778"
       MouseDown="BtnAtras_MouseDown"/>
        <Image x:Name="BtnSalir" Source="{StaticResource BTN_SALIR}" Margin="888,38,19,1778"
       MouseDown="BtnSalir_MouseDown"/>
        <TextBlock x:Name="TxtTimer" Text="" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,23,0,0"/>

        <!--BODY-->

        <TextBlock 
         Text="Selecciona la opción a utilizar" Style="{StaticResource TitleStyle}"
         Margin="0,407,0,0"
         FontSize="60"
         Width="482"/>

        <Image 
   Source="{StaticResource BTN_REFERENCIA}"  Margin="402,730,402,900"
   MouseDown="Btn_ReferenciaMouseDown"/>

        <Image 
   Source="{StaticResource BTN_REFERENCIA}" Visibility="Hidden"  Margin="621,730,183,900"
   MouseDown="Btn_EscaneaMouseDown"/>

        <!--FOOTER-->

        <Image Source="{StaticResource ATENTION_LINE}" Margin="292,1740,292,50" />

    </Grid>
</local:AppUserControl>

<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.AuthenticationUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             Height="1920" 
             Width="1080">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BTN_AUTENTICATE}" Stretch="Uniform"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
            <RowDefinition Height="400" />
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,644" Grid.RowSpan="2">
            <TextBlock x:Name="TxtTimer" d:Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,22,0,0"/>
        </Grid>

        <Grid Grid.Row="1" >
            <local:GifViewer PathFolder="Images/Gif/GifHuella" Margin="428,10,10,488" RenderTransformOrigin="0.5,0.5" >
                <local:GifViewer.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </local:GifViewer.RenderTransform>
            </local:GifViewer>
            <TextBlock x:Name="TxtStatusMsg"
               Text="{Binding StatusMsg}"
               Style="{StaticResource StatusTextStyle}" 
               Margin="0,58,0,0"/>
        </Grid>

        <Grid Grid.Row="2" >
            <Image 
                Name="BtnCancelar"
                Source="/Images/Buttons/BtnCancelar.png"
                Height="90"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="583,46,0,0"
                Stretch="Uniform"
                PreviewMouseDown="OpcionButton_Click"
            />
        </Grid>

    </Grid>
</local:AppUserControl>

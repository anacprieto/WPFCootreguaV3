<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.ManualInputUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="1920" d:DesignWidth="1080">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </Grid.Background>

        <!-- HEADER -->
        <Image x:Name="BtnAtras" Source="{StaticResource BTN_ATRAS}" Margin="47,38,867,1778"
            MouseDown="BtnAtras_MouseDown"/>
        <Image x:Name="BtnSalir" Source="{StaticResource BTN_SALIR}" Margin="888,38,19,1778"
            MouseDown="BtnSalir_MouseDown"/>
        <TextBlock x:Name="TxtTimer" d:Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,22,0,0"/>


        <!-- BODY -->
        <TextBlock 
            Text="Digita tu referencia de pago o escanea tu factura" Style="{StaticResource TitleStyle}"
            Margin="332,357,0,0"
            x:Name="TxtTypeConsult"
            FontSize="40"
            Width="640" Height="126" HorizontalAlignment="Left"
        />

        <Image x:Name="IcoReferencia" Visibility="Visible" Source="{StaticResource ICO_REFERENCIA}" Margin="130,338,762,1447" />

        <Border Background="LightGray" Visibility="Visible" Height="134" CornerRadius="20" VerticalAlignment="Top" Margin="47,638,32,0" >
            <TextBox x:Name="InputInvoice" FontSize="65" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black" d:Text="0001000000010008000000000" VerticalContentAlignment="Center" 
                     TextChanged="TxtInvoice_TextChanged" Background="{x:Null}" SelectionBrush="{x:Null}" SelectionTextBrush="{x:Null}" BorderBrush="{x:Null}" Height="114" Margin="10,0,10,0"/>
        </Border>


        <TextBlock  x:Name="TxtStatusMsg"
                    md:HintAssist.Hint="Usuario"
                    Text="{Binding StatusMsg}"
                    Style="{StaticResource StatusTextStyle}" 
                    Margin="0,665,0,0"/>

        <local:NumericKeyboard  x:Name="Keyboard"  Margin="319,840,319,541"  />



        <Image
            x:Name="BtnPagar"
            Source="{StaticResource BTN_CONSULTAR}" Margin="0,1534,0,0"
            MouseDown="BtnConsultar_Touch" HorizontalAlignment="Center" Width="394" Height="104" VerticalAlignment="Top"
            />

        <!--FOOTER-->

        <Image Source="{StaticResource ATENTION_LINE}" Margin="292,1740,292,50" />

    </Grid>
</local:AppUserControl>

<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.IdentificationUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             Height="1720" 
             Width="680"
             Panel.ZIndex="1">
    
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="500" />
            <RowDefinition Height="*" />
            <RowDefinition Height="400" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock x:Name="TxtTimer" d:Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="0,22,0,0"/>
            <TextBox
            x:Name="TxtIdentification"
            md:HintAssist.Hint="      Ingrese su Cédula"
            md:HintAssist.IsFloating="True"
            md:HintAssist.FloatingScale="0.3"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsEnabled="False"
            Tag="Identification"
            Margin="0,0,0,150" 
            Width="550"
            TextAlignment="Center"
            FontSize="50"
            TextChanged="TxtIdentification_TextChanged" BorderBrush="{x:Null}"
        />
            <Label 
            x:Name="lblErrorIdentification"
            Content=""
            Foreground="Red"
            FontSize="25"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Margin="0,0,0,80"
            FontWeight="Bold" 
        />
        </Grid>

        <Grid Grid.Row="1">
            <local:NumericKeyboard x:Name="Keyboard" Margin="10,61,10,206" />
        </Grid>

        <Grid Grid.Row="2">
            <Image 
            Name="BtnContinuar"
            Source="/Images/Buttons/BtnContinuar.png"
            Height="90"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,923,21,0"
            Stretch="Uniform" 
            Opacity="0.3"
            IsEnabled="False"
            MouseDown="BtnConsultar_Touch"
        />
            <Image 
            Name="BtnCancelar"
            Source="/Images/Buttons/BtnAnterior.png"
            Height="90"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="73,1013,0,0"
            Stretch="Uniform"
            TouchDown="Btn_Cancelar_Touch" RenderTransformOrigin="0.502,-0.244"
        />
        </Grid>

    </Grid>

</local:AppUserControl>

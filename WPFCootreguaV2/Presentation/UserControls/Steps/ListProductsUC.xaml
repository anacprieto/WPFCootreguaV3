<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.ListProductsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="1920" d:DesignWidth="1080">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BTN_PRODUCTOS}" Stretch="Uniform"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="400" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <ListView 
         x:Name="lv_Products"
         HorizontalAlignment="Center" 
         VerticalAlignment="Top"
         ItemsSource="{Binding}"
         Margin="0,0,0,0"
         Grid.Row="1"
         Grid.ColumnSpan="7"
         Background="Transparent"
         BorderBrush="Transparent"
         AutomationProperties.AutomationId="ItemGridView"
         AutomationProperties.Name="Grouped Items"
         >
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}"
                 >
                        <!--<EventSetter Event="TouchDown"
                  Handler="ListViewItem_TouchDown" />-->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter>
                                    </ContentPresenter>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1"
                          HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel 
                     Orientation="Vertical" 
                     VerticalAlignment="Stretch" 
                     HorizontalAlignment="Stretch">
                            <Grid 
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,20,0,0"
                         Width="660"
                         >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock 
                             FontSize="25"
                             TextAlignment="Left"
                             TextWrapping="Wrap"
                             Margin="30,0,0,0"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             Grid.Column="0"
                         >
                         <Run Foreground="Gray" FontWeight="Bold" Text="Número del producto" /><LineBreak/>
                         <Run Foreground="Black" Text="{Binding NumberProduct}"/>
                         <Run Foreground="Gray" FontWeight="Bold" Text="-" />
                         <Run Foreground="Black" FontSize="22" Text="{Binding NameLine}"/><LineBreak/>
                         <Run Foreground="Gray" FontWeight="Bold" Text="Fecha del próximo pago: " /><LineBreak/>
                         <Run Foreground="{Binding ColorState}" Text="{Binding ProxDate,StringFormat='{}{0:dd/MM/yyyy}'}"/><LineBreak/>
                         <Run Foreground="Gray" FontWeight="Bold" Text="Valor de la cuota: " /><LineBreak/>
                         <Run Foreground="Black" Text="{Binding Cuota,StringFormat={}{0:C0}}"/><LineBreak/>
                         <Run Foreground="Gray" FontWeight="Bold" Text="Saldo: " /><LineBreak/>
                         <Run Foreground="Black" Text="********" Tag="{Binding Saldo}" Name="txtSaldo" TouchDown="txtSaldo_TouchDown"/><LineBreak/>
                                </TextBlock>
                                <TextBlock 
                             Text="{Binding ValorPagar, StringFormat={}{0:C0}}"
                             FontSize="35"
                             TextAlignment="Center"
                             Margin="0,0,0,0"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Grid.Column="1"
                         />
                                <Image  
                             x:Name="btnCheck"
                             Source="{Binding img}"
                             Width="45"
                             Height="45"
                             Grid.Column="2"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TouchDown="btnCheck_TouchDown"
                         />

                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Row="2">
            <Image 
         Name="btnPagar"
         Source="/Images/Buttons/BtnContinuar.png"
         Height="90"
         HorizontalAlignment="Right"
         VerticalAlignment="Top"
         Margin="0,50,30,0"
         Stretch="Uniform"
         TouchDown="btnPagar_TouchDown"
     />
            <Image 
         Name="btnCancelar"
         Source="/Images/Buttons/BtnCancelar.png"
         Height="90"
         HorizontalAlignment="Left"
         VerticalAlignment="Top"
         Margin="400,50,0,0"
         Stretch="Uniform"
         TouchDown="btnCancelar_TouchDown"
     />
        </Grid>
    </Grid>
</local:AppUserControl>

<local:AppUserControl x:Class="WPFCootreguaV2.UserControls.ListProductsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
              Height="1720" 
             Width="680" >
    
     <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="400" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock x:Name="TxtTimer" d:Text="00:59" Style="{StaticResource TimerStyle}" Foreground="{StaticResource PRIMARYCOLOR}" Margin="447,62,0,0" HorizontalAlignment="Left" Height="38" Width="134"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ListView x:Name="lv_Products"
          SelectionChanged="lv_Products_SelectionChanged"
          HorizontalAlignment="Center" 
          VerticalAlignment="Top"
          ItemsSource="{Binding}"
          Margin="0,0,0,0"
          Grid.Row="1"
          Grid.ColumnSpan="7"
          Background="Transparent"
          BorderBrush="Transparent"
          SelectionMode="Single"
          AutomationProperties.AutomationId="ItemGridView"
          AutomationProperties.Name="Grouped Items">

                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <EventSetter Event="TouchDown" Handler="ListViewItem_TouchDown" />
                        <EventSetter Event="MouseDown" Handler="ListViewItem_MouseDown" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" 
                                Background="Transparent" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" 
                                CornerRadius="8"
                                Margin="5,10">
                                        <ContentPresenter Margin="10"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F5F5F5"/>
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="3"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" 
                        VerticalAlignment="Stretch" 
                        HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="640">

                                <TextBlock FontSize="25"
                               TextAlignment="Left"
                               TextWrapping="Wrap"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Grid.Column="0">
                                <Run Foreground="Gray" FontWeight="Bold" Text="Número del producto" /><LineBreak/>
                                <Run Foreground="Black" Text="{Binding NumberProduct}"/>
                                <Run Foreground="Gray" FontWeight="Bold" Text="-" />
                                <Run Foreground="Black" FontSize="22" Text="{Binding NameLine}"/><LineBreak/>
                                <Run Foreground="Gray" FontWeight="Bold" Text="Fecha del próximo pago: " /><LineBreak/>
                                <Run Foreground="{Binding ColorState}" Text="{Binding ProxDate,StringFormat='{}{0:dd/MM/yyyy}'}"/><LineBreak/>
                                <Run Foreground="Gray" FontWeight="Bold" Text="Valor de la cuota: " /><LineBreak/>
                                <Run Foreground="Black" Text="{Binding Cuota,StringFormat={}{0:C0}}"/><LineBreak/>
                                <Run Foreground="Gray" FontWeight="Bold" Text="Saldo: " /><LineBreak/>
                                <Run Foreground="Black" Text="********" Tag="{Binding Saldo}" Name="txtSaldo" TouchDown="txtSaldo_TouchDown"/><LineBreak/>
                                </TextBlock>

                                <TextBlock Text="{Binding ValorPagar, StringFormat={}{0:C0}}"
                               FontSize="35"
                               TextAlignment="Center"
                               Margin="0,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Grid.Column="1"/>

                                <!-- Indicador visual de selección -->
                                <!--  <Ellipse Grid.Column="2"
                             Width="30"
                             Height="30"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="{Binding SelectionColor, FallbackValue=LightGray}"
                             Stroke="Gray"
                             StrokeThickness="2"/> -->

                                <TextBlock Grid.Column="2"
                               Text="✓"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Row="2">
            <Image 
         Name="btnPagar"
         Source="/Images/Buttons/BtnContinuar.png"
         Height="90"
         HorizontalAlignment="Right"
         VerticalAlignment="Top"
         Margin="0,50,30,0"
         Stretch="Uniform"
         MouseDown="btnPagar_TouchDown"
     />
            <Image 
         Name="btnCancelar"
         Source="/Images/Buttons/BtnCancelar.png"
         Height="90"
         HorizontalAlignment="Left"
         VerticalAlignment="Top"
         Margin="10,50,0,0"
         Stretch="Uniform"
         MouseDown="btnCancelar_TouchDown"
     />
        </Grid>
    </Grid>
</local:AppUserControl>

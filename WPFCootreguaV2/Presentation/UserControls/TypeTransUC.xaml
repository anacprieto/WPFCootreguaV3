<local:AppUserControl x:Class="WPFCootreguaV2.Presentation.UserControls.TypeTransUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFCootreguaV2.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="1920" d:DesignWidth="1080">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{StaticResource BACKGENERIC}" Stretch="Uniform"/>
        </Grid.Background>
        <!-- BOTONES -->
        <Grid x:Name="BtnPagar" Tag="1" Height="70" Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="562,1280,0,0" MouseDown="SelectOption" Cursor="Hand">
            <Border Background="#96d12c" CornerRadius="25">
                <Grid>
                    <!-- Sección izquierda con ícono -->
                    <Border Width="40" Height="70" Background="#373737" CornerRadius="10,0,0,10" HorizontalAlignment="Left">
                        <Polyline Points="8,1 20,16 8,31"
                      Stroke="White"
                      StrokeThickness="8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>

                    </Border>
                    <TextBlock x:Name="BtnPagarTexto"
                   Text="Pagar" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   FontSize="36" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="BtnRetirar" Tag="2" Height="70" Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="562,1416,0,0" MouseDown="SelectOption" Cursor="Hand">
            <Border Background="#96d12c" CornerRadius="25">
                <Grid>
                    <!-- Sección izquierda con ícono -->
                    <Border Width="40" Height="70" Background="#373737" CornerRadius="10,0,0,10" HorizontalAlignment="Left">
                        <Polyline Points="8,1 20,16 8,31"
                      Stroke="White"
                      StrokeThickness="8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>

                    </Border>
                    <TextBlock
                       Text="Retirar" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       FontSize="36" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="BtnRegistrar" Tag="3" Height="70" Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="562,1552,0,0" MouseDown="SelectOption" Cursor="Hand">
            <Border Background="#96d12c" CornerRadius="25">
                <Grid>
                    <!-- Sección izquierda con ícono -->
                    <Border Width="40" Height="70" Background="#373737" CornerRadius="10,0,0,10" HorizontalAlignment="Left">
                        <Polyline Points="8,1 20,16 8,31"
                          Stroke="White"
                          StrokeThickness="8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>

                    </Border>
                    <TextBlock
                       Text="Registrar" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       FontSize="36" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:AppUserControl>

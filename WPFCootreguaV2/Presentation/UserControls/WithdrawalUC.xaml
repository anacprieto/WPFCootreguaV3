    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="450" />
            <RowDefinition Height="600" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock 
